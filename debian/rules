#!/usr/bin/make -f

%:
	dh $@

# Installation paths live in the Makefile so that the Debian packaging, the
# Arch PKGBUILD and the RPM spec all agree on them.
override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/scuf-controller

override_dh_auto_build:
override_dh_auto_test:
	$(MAKE) check
