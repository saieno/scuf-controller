# The scuf-controller service takes exclusive control of the physical pad and
# re-presents it as a virtual Xbox 360 controller. The raw device stays
# visible to udev, so SDL and Steam would list it alongside the virtual pad as
# a second, permanently-idle gamepad. Untag it so they skip it.
#
# Trade-off: while these rules are in place the raw pad is hidden from
# gamepad enumeration even when the service is stopped.
#
# Do not edit this file; a package upgrade will overwrite it. To change or
# disable the rules, shadow it with a file of the same name in /etc, which
# udev reads in preference to this one:
#
#     sudo cp /usr/lib/udev/rules.d/60-scuf-controller.rules /etc/udev/rules.d/
#     sudoedit /etc/udev/rules.d/60-scuf-controller.rules
#     sudo udevadm control --reload && sudo udevadm trigger
#
# An empty file at that path disables the rules entirely. To add another
# controller, find its ids with `lsusb` and copy one of the lines below.

# SCUF Gaming (generic DualShock-clone HID)
SUBSYSTEM=="input", ATTRS{idVendor}=="2e95", ATTRS{idProduct}=="7725", ENV{ID_INPUT_JOYSTICK}=""

# Sony DualShock 4 (first and second revision) and DualSense
SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", ENV{ID_INPUT_JOYSTICK}=""
SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", ENV{ID_INPUT_JOYSTICK}=""
SUBSYSTEM=="input", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", ENV{ID_INPUT_JOYSTICK}=""
