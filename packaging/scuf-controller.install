post_install() {
	cat <<'MSG'
==> scuf-controller is installed but not started. Enable it with:
==>     sudo systemctl enable --now scuf-controller
==>
==> Check that your pad is recognised first:
==>     scuf-controller --list
==>
==> If it matches no profile, generate one:
==>     scuf-controller --dump-profile > /etc/scuf-controller.d/mypad.conf
MSG
}

post_upgrade() {
	# 1.x drove the pad with xboxdrv and installed a root cron job; 2.0 uses
	# neither. Nothing is migrated automatically.
	if [ -n "$2" ] && [ "$(vercmp "$2" 2.0)" -lt 0 ]; then
		cat <<'MSG'
==> 2.0 replaces xboxdrv with a built-in evdev daemon. If you carried settings
==> in /usr/local/ds4.conf, port them to a profile in /etc/scuf-controller.d.
==> Check that the old cron entry is gone:
==>     sudo crontab -l | grep cleanup-ds4
MSG
	fi
}
